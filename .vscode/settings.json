{
  "C_Cpp.intelliSenseEngine": "default",
  "idf.port": "COM5",
  "idf.flashType": "UART",
  "idf.monitorPort": "COM5",
  "idf.espIdfPath": "c:\\Espressif\\frameworks\\esp-idf-v5.5.3",
  "idf.toolsPath": "c:\\Espressif",
  "idf.pythonInstallPath": "c:\\Espressif\\python_env\\idf5.5_py3.11_env\\Scripts\\python.exe",
  "idf.openOcdConfigs": [
    "interface/ftdi/esp32_devkitj_v1.cfg",
    "target/esp32.cfg"
  ],
  "idf.customExtraVars": {
    "IDF_TARGET": "esp32"
  },
  "files.associations": {
    "i2c_master.h": "c"
  },

  "terminal.integrated.profiles.windows": {
    "ESP-IDF PowerShell": {
      "path": "C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": [
        "-ExecutionPolicy", "Bypass",
        "-NoExit",
        "-File", "C:\\Espressif\\Initialize-Idf.ps1",
        "-IdfId", "esp-idf-v5.5.3-v5.5"
      ]
    },
    "ESP-IDF CMD": {
      "path": "C:\\WINDOWS\\System32\\cmd.exe",
      "args": [
        "/k",
        "C:\\Espressif\\frameworks\\esp-idf-v5.5.3\\export.bat"
      ]
    },
    "PowerShell": {
      "source": "PowerShell",
      "args": ["-ExecutionPolicy", "Bypass"]
    },
    "Command Prompt": {
      "path": "C:\\WINDOWS\\System32\\cmd.exe"
    }
  },
  "terminal.integrated.defaultProfile.windows": "ESP-IDF PowerShell"
}
