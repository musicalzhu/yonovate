{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ESP-IDF: Debug",
      "type": "espidf",
      "request": "launch",
      "mode": "manual",
      "program": "${workspaceFolder}/build/${workspaceFolderBasename}.elf",
      "debugPort": 3333,
      "preLaunchTask": "esp-idf: openocd",
      "initCommands": [
        "target remote :3333",
        "monitor reset halt",
        "flushregs"
      ]
    }
  ]
}