# WiFi默认配置
# 主任务栈大小 (8KB - 支持精简状态机配置)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# STA模式默认配置（连接路由器）
CONFIG_WIFI_DEFAULT_SSID="XINGHUI"
CONFIG_WIFI_DEFAULT_PASSWORD="88888888"

# AP模式默认配置（配网热点）
CONFIG_WIFI_AP_SSID="Yonovate-Setup"
CONFIG_WIFI_AP_PASSWORD="12345678"

# Flash 配置 (4MB)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Unity 测试框架通过 IDF_BUILD_TESTS 启用
